# Configuration contract for future environment-variable integration.
# Current scripts DO NOT load .env or read the variables below.
# See README.md for the currently supported setup commands and storage.
# Copy to .env only if it does not already exist. Never commit real credentials.

# Proposed channels: kakao, azure_email, or kakao,azure_email.
NOTIFIER_CHANNELS=kakao

# Proposed completion policy. These switches are NOT implemented yet.
NOTIFIER_NOTIFY_CHAT=false
NOTIFIER_NOTIFY_PLAN=false
NOTIFIER_NOTIFY_AUTOPILOT=true

# Kakao Developers app: REST API key, NOT the JavaScript/admin key.
# Current setup prompts for credentials and saves tokens using Windows DPAPI.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:53682/
KAKAO_MESSAGE_URL=https://github.com/brjeong-private/copilot-notifier
# No phone number is needed: messages go to the authorized user's My Chat.
# Do not put access/refresh tokens here; use Connect-Kakao.ps1.

# Azure Communication Services Email (ACS), NOT Microsoft Graph/SMTP.
# Current manual scripts use az login (Microsoft Entra ID), not access keys.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-copilot-tools
AZURE_LOCATION=westus3
AZURE_COMMUNICATION_ENDPOINT=https://YOUR-ACS-RESOURCE.communication.azure.com
AZURE_EMAIL_SENDER=DoNotReply@YOUR-VERIFIED-DOMAIN
AZURE_EMAIL_RECIPIENT=you@example.com
# Sender must belong to a verified email domain linked to the ACS resource.
# Do not put Azure CLI access tokens or connection strings here.
